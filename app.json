{
  "expo": {
    "name": "Kotoba Offline",
    "slug": "kotoba-offline",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "kotobaoffline",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.dimas.kotobaoffline",
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "icon": "./assets/icon.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan Kotoba Offline memilih foto untuk profile."
        }
      ],
      "expo-font",
      "expo-notifications"
    ],
    "icon": "./assets/icon.jpg"
  }
}
